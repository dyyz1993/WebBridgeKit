# Install as /etc/nginx/conf.d/__DREL_SELF_HOSTED_DOMAIN__.conf after
# replacing the two placeholders. Obtain the certificate with the existing
# host's preferred ACME flow before reloading this TLS configuration.
server {
    listen 80;
    listen [::]:80;
    server_name __DREL_SELF_HOSTED_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DREL_SELF_HOSTED_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DREL_SELF_HOSTED_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DREL_SELF_HOSTED_DOMAIN__/privkey.pem;
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
