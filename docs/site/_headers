/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=604800

/test/offline/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/test/offline/package.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/test/offline/drel-offline-demo-v1.zip
  Content-Type: application/zip
  Cache-Control: public, max-age=31536000, immutable

/test/offline/v1/*
  Cache-Control: public, max-age=31536000, immutable

/test/offline-network/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/test/offline-network/package.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/test/offline-network/drel-offline-network-demo-v1.zip
  Content-Type: application/zip
  Cache-Control: public, max-age=31536000, immutable

/test/offline-network/v1/*
  Cache-Control: public, max-age=31536000, immutable

/skills/drel-app-development/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/skills/drel-app-development/drel-app-development-1.0.0.zip
  Content-Type: application/zip
  Cache-Control: public, max-age=31536000, immutable
