<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Required for the NSE icon avatar: iOS renders a donated
	     INSendMessageIntent as a communication notification (sender avatar
	     in the app-icon slot) only when the MAIN APP carries this
	     entitlement (Bark mirrors it in Bark.entitlements). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.webbridgekit.superapp</string>
	</array>
</dict>
</plist>
